entity WayBill {
  boxLimit Integer,
  shipmentType String,
  opfac String,
  deliveryAgent String,
  estimatedReadyDate Instant,
  currencyUom String,
  estimatedShipDate Instant,
  status String,
  referenceNumber String
}

entity CurrencyType {
  name String
}

relationship ManyToOne {
  WayBill to CurrencyType { currencyType required }
}

dto WayBill, CurrencyType with mapstruct
paginate WayBill, CurrencyType with pagination
filter WayBill, CurrencyType
